# ─────────────────────────────────────────────────────────────────────────────
# Google Earth Engine Worker — Environment Variables Template
# Copy to Google_Earth_Engine/.env.production and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Realtime Database ────────────────────────────────────────────────
FIREBASE_REALTIME_DB=https://your-project-default-rtdb.firebaseio.com/

# ── Google Earth Engine ───────────────────────────────────────────────────────
EE_PROJECT=your-gcp-project-id
EE_OPT_URL=https://earthengine-highvolume.googleapis.com

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=your-gcs-bucket-name

# ── Service Account Keys (base64-encoded JSON) ────────────────────────────────
# Encode your service account JSON:  base64 -w 0 firebase-sa.json
# NEVER commit the actual key values — only this example file goes in git
FIREBASE_KEY_BASE64=base64_encoded_firebase_admin_service_account_json_here
GCS_KEY_BASE64=base64_encoded_gcs_service_account_json_here

# ── Job to run (overridden by docker-compose environment) ─────────────────────
JOB_NAME=vegetation_data
