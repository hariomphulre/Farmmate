# ─────────────────────────────────────────────────────────────────────────────
# Server Environment Variables Template
# Copy to server/.env.production and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# Leave empty to only allow localhost (dev defaults are always included)
# For production, set the real public domain behind your reverse proxy.
ALLOWED_ORIGINS=https://farmmate.hariomphulre.tech,https://www.farmmate.hariomphulre.tech,http://farmmate.hariomphulre.tech,http://www.farmmate.hariomphulre.tech

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get from: https://console.neon.tech/ → Your Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth / Email ────────────────────────────────────────────────────────────
# Firebase Auth Settings
FIREBASE_PROJECT_ID=your_firebase_project_id

# reCAPTCHA secret key used to verify client tokens on the server
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# JWT signing secret used for local auth sessions
JWT_SECRET=replace_with_a_long_random_secret

# Gmail / SMTP sender for OTP and reset emails
EMAIL_USER=noreply.farmmate@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Weather APIs ──────────────────────────────────────────────────────────────
# OpenWeatherMap (current weather, free tier available)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# WeatherAPI.com (historical data for /api/weather-for-farmer)
WEATHER_API_KEY=your_weatherapi_com_key_here

# ── News API ──────────────────────────────────────────────────────────────────
NEWSDATA_API_KEY=your_newsdata_io_api_key_here

# ── ML Service URL ────────────────────────────────────────────────────────────
# Docker service name resolves via internal DNS — do not change for Docker deployments
ML_SERVICE_URL=http://ml-service:8000

# ── Field coordinates (initial seed, updated at runtime by manipal API) ───────
COORDINATES=[[74.95114151586296,21.40850693263666],[74.95316926587822,21.408307161222726]]
