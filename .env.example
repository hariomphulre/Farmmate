# ─────────────────────────────────────────────────────────────────────────────
# Farmmate — Root Environment Variables Template
# Copy to .env.production and fill in real values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# ── App Ports ────────────────────────────────────────────────────────────────
# Keep the app on 8081 externally because 8080 is used by another project.
NGINX_PORT=8081
SERVER_PORT=5000
ALLOWED_ORIGINS=https://farmmate.hariomphulre.tech

# ── SSH / GitHub Actions deployment ───────────────────────────────────────────
# Use the VPS public IP or a DNS-only hostname; do not use a Cloudflare proxied
# hostname for SSH. Keep the SSH port as 2222 if your VPS is configured that way.
VPS_HOST=your_vps_public_ip_or_dns
VPS_PORT=2222
VPS_USERNAME=your_user

# ── GEE Worker job name ───────────────────────────────────────────────────────
# Options: vegetation_data | soil_data | weather_data | water_data | rainfall_data | fire_data
GEE_JOB_NAME=vegetation_data
