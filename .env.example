# ─────────────────────────────────────────────────────────────────────────────
# Farmmate — Root Environment Variables Template
# Copy to .env.production and fill in real values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# ── App Ports ────────────────────────────────────────────────────────────────
SERVER_PORT=5000
ALLOWED_ORIGINS=https://farmmate.hariomphulre.tech,https://www.farmmate.hariomphulre.tech,http://farmmate.hariomphulre.tech,http://www.farmmate.hariomphulre.tech

# ── Frontend build-time public env vars ──────────────────────────────────────
# These are baked into the client bundle during docker build.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GROQ_API_KEY=your_groq_api_key
VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
VITE_DATA_GOV_API_KEY=your_data_gov_api_key

# ── Backend runtime env vars ──────────────────────────────────────
# These are consumed by the server container at runtime.
FIREBASE_PROJECT_ID=your_project_id
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
DATABASE_URL=your_postgres_database_url
JWT_SECRET=your_jwt_secret

# ── SSH / GitHub Actions deployment ───────────────────────────────────────────
# Use the VPS public IP or a DNS-only hostname; do not use a Cloudflare proxied
# hostname for SSH. Keep the SSH port as 2222 if your VPS is configured that way.
VPS_HOST=your_vps_public_ip_or_dns
VPS_PORT=2222
VPS_USERNAME=your_user

# ── GEE Worker job name ───────────────────────────────────────────────────────
# Options: vegetation_data | soil_data | weather_data | water_data | rainfall_data | fire_data
GEE_JOB_NAME=vegetation_data
